{
  "manifest_version": 3,
  "name": "半吊牌 · 评论区选题夹",
  "version": "0.7.0",
  "description": "从已加载的抖音评论找选题，关联拍法笔记，在本机编辑和收藏。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "收集博主作品或当前作品评论"
  },
  "host_permissions": [
    "https://www.douyin.com/*"
  ],
  "optional_host_permissions": [
    "https://www.iesdouyin.com/*",
    "https://iesdouyin.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "index.html"
      ],
      "matches": [
        "file:///*"
      ]
    }
  ]
}
